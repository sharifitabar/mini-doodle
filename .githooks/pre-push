#!/bin/sh
# Pre-push guard: run the exact build CI runs (see .github/workflows/ci.yml) and
# abort the push if it fails, so a red build never reaches main.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip deliberately (rare): git push --no-verify
set -e

echo "pre-push: running './gradlew build --no-daemon --console=plain' (same as CI)..."
./gradlew build --no-daemon --console=plain
echo "pre-push: build passed."
